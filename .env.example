# AI Viral Radar — Environment Configuration

# Primary AI Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Primary Web Research & Scraping Layer: Firecrawl
FIRECRAWL_API_KEY=

# Database Configuration (Default: SQLite for zero-config portable execution)
DATABASE_URL=sqlite+aiosqlite:///./viral_radar.db
# PostgreSQL example: postgresql+asyncpg://postgres:password@localhost:5432/viral_radar

# Discovery & Automation Settings
DISCOVERY_INTERVAL_MINUTES=30
VIRAL_THRESHOLD=70.0
MAX_SEARCH_RESULTS=5
MAX_PAGES_PER_DISCOVERY=10

# Anti-Copy Safeguard
SIMILARITY_THRESHOLD=0.60

# Optional Authorized X API Bearer Token
X_API_BEARER_TOKEN=

# Application Server
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=true
DEMO_MODE=true
