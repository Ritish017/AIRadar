5. DETERMINISTIC GSAP TIMELINE CODE
--------------------------------------------------------------------------------
```javascript
// HyperFrames Deterministic GSAP Timeline Contract
// Rules: timeline is paused, registered on window.__timelines, uses absolute positions
window.__timelines = window.__timelines || {};

const root = document.querySelector("#hf_news_35s");
if (!root) throw new Error("HyperFrames composition root '#hf_news_35s' not found.");

// Set initial invisible states
gsap.set("#hf_news_35s .badge-container", { opacity: 0, scale: 0.8, y: -20 });
gsap.set("#hf_news_35s .main-headline", { opacity: 0, y: 40 });
gsap.set("#hf_news_35s .sub-headline", { opacity: 0, y: 20 });
gsap.set("#hf_news_35s .metric-hud-card", { opacity: 0, y: 80, scale: 0.95 });
gsap.set("#hf_news_35s .metric-progress-fill", { width: "0%" });
gsap.set("#hf_news_35s .terminal-preview-card", { opacity: 0, y: 60 });
gsap.set("#hf_news_35s .code-output", { opacity: 0 });
gsap.set("#hf_news_35s .footer-action-bar", { opacity: 0, scale: 0.9 });

// Construct deterministic paused timeline
const tl = gsap.timeline({ paused: true });

tl.to("#hf_news_35s .badge-container", { opacity: 1, scale: 1, y: 0, duration: 0.6, ease: "back.out(1.6)" }, 0.2)
  .to("#hf_news_35s .main-headline", { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }, 0.5)
  .to("#hf_news_35s .sub-headline", { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 0.8)
  .to("#hf_news_35s .metric-hud-card", { opacity: 1, y: 0, scale: 1, duration: 1.0, ease: "power4.out" }, 1.5)
  .to("#hf_news_35s .metric-progress-fill", { width: "86%", duration: 1.4, ease: "power2.inOut" }, 2.2)
  .to("#hf_news_35s .terminal-preview-card", { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 4.0)
  .to("#hf_news_35s .code-output", { opacity: 1, duration: 0.1, ease: "none" }, 5.2)
  .to("#hf_news_35s .footer-action-bar", { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.4)" }, 7.0);

// Expose timeline and frame seeker to HyperFrames renderer
window.__timelines["hf_news_35s"] = tl;
window.renderFrame = function(timeInSeconds) {
  tl.seek(timeInSeconds);
};

